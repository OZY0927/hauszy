rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }
    match /projects/{projectId}/{fileId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if signedIn();
    }
    match /profile/{fileId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if signedIn();
    }
    match /{path=**} { allow read, write: if false; }
  }
}
