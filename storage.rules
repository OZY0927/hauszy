rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.uid == '7gyEPhGlL6V8DlLb5dNGzuwO95A2';
    }
    match /projects/{projectId}/{fileId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }
    match /profile/{fileId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }
    match /{path=**} { allow read, write: if false; }
  }
}
