# Required for production canonical URLs, sitemap entries and structured data.
NEXT_PUBLIC_SITE_URL=https://your-primary-domain.com
# Enable only after confirming the GA4 property and disabling Enhanced Measurement.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Optional: uses the existing Firebase Analytics measurement ID if unset.
NEXT_PUBLIC_GOOGLE_TAG_ID=G-K8BKKWHX2Z
# Optional: Search Console HTML verification token (not the entire meta tag).
GOOGLE_SITE_VERIFICATION=

# Supabase image storage. Set public values during the build and in the runtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only encrypted secret on Cloudflare. Never add NEXT_PUBLIC_ to this name.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=website-images
