rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.uid == '7gyEPhGlL6V8DlLb5dNGzuwO95A2';
    }
    match /siteContent/about { allow read: if true; allow write: if isAdmin(); }
    match /adminSettings/projectOptions { allow read, write: if isAdmin(); }
    match /projects/{id} { allow read, write: if isAdmin(); }
    match /guideDrafts/{slug} { allow read, write: if isAdmin(); }
    match /guidePublications/{slug} {
      allow read: if true;
      allow create, update: if isAdmin() && (
        (request.resource.data.status == 'Published'
          && request.resource.data.keys().hasOnly([
            'status', 'title', 'summary', 'body', 'author', 'seoTitle', 'seoDescription',
            'category', 'coverUrl', 'coverAlt', 'projectId', 'projectIds', 'tools', 'sources', 'publishedAt', 'updatedAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.summary is string
          && request.resource.data.body is string
          && request.resource.data.author is string
          && (!('projectId' in request.resource.data) || request.resource.data.projectId is string)
          && (!('projectIds' in request.resource.data) || request.resource.data.projectIds is list)
          && request.resource.data.publishedAt is string
          && request.resource.data.updatedAt is string)
        || (request.resource.data.status == 'Withdrawn' && request.resource.data.keys().hasOnly(['status']))
      );
    }
    match /publicProjects/{id} {
      allow read: if isAdmin() || resource.data.status == 'Published';
      allow create, update: if isAdmin() && request.resource.data.status == 'Published';
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
